<!DOCTYPE html>
<html>
<head>
<title>My Online Shop</title>

<style>
body{
    font-family: Arial;
    margin:0;
    background:#f2f2f2;
}

header{
    background:#222;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#444;
    padding:10px;
    text-align:center;
}

nav a{
    color:white;
    margin:20px;
    text-decoration:none;
}

.container{
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
    margin:30px;
}

.product{
    background:white;
    width:250px;
    padding:20px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px gray;
}

.product img{
    width:200px;
    height:150px;
}

button{
    background:green;
    color:white;
    padding:10px;
    border:none;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:darkgreen;
}

footer{
    background:#222;
    color:white;
    text-align:center;
    padding:15px;
}
</style>

</head>

<body>

<header>
<h1>Krishna Online Shop</h1>
<p>Best Products At Best Price</p>
</header>


<nav>
<a href="#">Home</a>
<a href="#">Products</a>
<a href="#">Cart</a>
<a href="#">Contact</a>
</nav>


<div class="container">

<div class="product">
<img src="https://via.placeholder.com/200">
<h2>Mobile Phone</h2>
<p>Price: ₹15000</p>
<button>Add To Cart</button>
</div>


<div class="product">
<img src="https://via.placeholder.com/200">
<h2>Laptop</h2>
<p>Price: ₹45000</p>
<button>Add To Cart</button>
</div>


<div class="product">
<img src="https://via.placeholder.com/200">
<h2>Headphones</h2>
<p>Price: ₹2000</p>
<button>Add To Cart</button>
</div>

</div>


<footer>
<p>© 2026 Krishna Online Shop</p>
</footer>


</body>
</html>
